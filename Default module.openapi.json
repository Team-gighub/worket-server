                    "type": "string",
                    "maxLength": 100,
                    "description": "업종",
                    "nullable": true
                  },
                  "businessSectorYears": {
                    "type": "integer",
                    "minimum": -9223372036854776000,
                    "maximum": 9223372036854776000,
                    "description": "업력",
                    "nullable": true
                  },
                  "businessRegistrationNumber": {
                    "type": "string",
                    "description": "사업자등록번호"
                  }
                },
                "required": [
                  "businessRegistrationNumber"
                ]
              },
              "example": {
                "birthDate": "1987-08-05",
                "gender": "MALE",
                "businessSector": "청소",
                "businessSectorYears": 4,
                "businessRegistrationNumber": "69077934708"
              }
