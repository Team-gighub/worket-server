                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "이름"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "FREELANCER",
                        "CLIENT",
                        "ADMIN"
                      ],
                      "default": "FREELANCER",
                      "description": "유저 role\n",
                      "nullable": true
                    },
                    "phone": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "핸드폰번호 11자리",
                      "nullable": true
                    },
                    "birthDate": {
                      "type": "string",
                      "format": "date",
                      "description": "생년월일",
                      "nullable": true
                    },
                    "gender": {
                      "type": "string",
                      "enum": [
                        "MALE",
                        "FEMALE"
                      ],
                      "description": "성별",
                      "nullable": true
                    },
                    "businessSector": {
                      "type": "string",
                      "maxLength": 100,
                      "description": "업종",
                      "nullable": true
                    },
                    "businessSectorYears": {
                      "type": "integer",
                      "minimum": -9223372036854776000,
                      "maximum": 9223372036854776000,
                      "description": "업력",
                      "nullable": true
                    },
                    "businessRegistrationNumber": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "사업자등록번호\n",
                      "nullable": true
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "example": {
                  "name": "이영은",
                  "role": "FREELANCER",
                  "phone": "01023970938",
                  "birthDate": "1998-11-23",
                  "gender": "FEMALE",
                  "businessSector": "디자인",
                  "businessSectorYears": 8,
                  "businessRegistrationNumber": "9325863715"
