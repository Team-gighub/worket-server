#!/bin/sh
echo "🧹 Auto-formatting code with Spotless..."

# 모든 플랫폼에서 UTF-8 강제
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"
export GRADLE_OPTS="-Dfile.encoding=UTF-8"

# 현재 스테이징된 파일 목록 저장
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# OS 감지 및 적절한 Gradle 래퍼 사용
if [ -f "./gradlew.bat" ] && [ "$OSTYPE" = "msys" ]; then
  # Windows (Git Bash)
  ./gradlew.bat spotlessApply --quiet
else
  # Mac/Linux
  ./gradlew spotlessApply --quiet
fi

# 원래 스테이징된 파일들만 다시 추가
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs git add

  # 포맷팅으로 변경된 파일 확인
  CHANGED_FILES=$(echo "$STAGED_FILES" | while read file; do
    if git diff --cached --name-only | grep -q "^$file$"; then
      echo "$file"
    fi
  done)

  if [ -n "$CHANGED_FILES" ]; then
    echo ""
    echo "📝 Auto-formatted files:"
    echo "$CHANGED_FILES" | sed 's/^/  - /'
    echo ""
    echo "⚠️  Files were automatically formatted and re-staged."
  else
    echo "✅ No formatting changes needed."
  fi
else
  echo "✅ No files staged for commit."
fi

echo "✅ Pre-commit checks complete!"
